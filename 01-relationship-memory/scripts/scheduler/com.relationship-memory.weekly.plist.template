<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Relationship Memory weekly run (macOS launchd). Runs Monday 07:00 local time.
  1. Replace YOUR_USERNAME below (run `whoami`).
  2. cp com.relationship-memory.weekly.plist.template ~/Library/LaunchAgents/com.relationship-memory.weekly.plist
  3. launchctl load ~/Library/LaunchAgents/com.relationship-memory.weekly.plist
  4. Test now: launchctl start com.relationship-memory.weekly
  If the Mac is asleep at 07:00, launchd runs the job when it wakes.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.relationship-memory.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR_USERNAME/.relationship-memory/bin/run_weekly.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/.relationship-memory/reports/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/.relationship-memory/reports/launchd.err</string>
</dict>
</plist>
